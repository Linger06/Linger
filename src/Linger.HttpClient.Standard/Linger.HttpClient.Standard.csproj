<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0;net9.0;net8.0;netstandard2.0;net472;</TargetFrameworks>
    <Version>2.0.0-preview.5</Version>
    <Description>
      A lightweight implementation of Linger.HttpClient.Contracts using standard .NET HttpClient.
      Provides typed response parsing, per-request headers, and streaming file transfers.
      Seamlessly integrates with .NET's HttpClientFactory for optimal connection management.
    </Description>
</PropertyGroup>

  <ItemGroup>
</ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.23" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" Condition="'$(TargetFramework)' == 'netstandard2.0' OR '$(TargetFramework)' == 'net472'" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net472'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Linger.HttpClient.Contracts\Linger.HttpClient.Contracts.csproj" />
    <ProjectReference Include="..\Linger.Json\Linger.Json.csproj" />
    <ProjectReference Include="..\Linger\Linger.csproj" />
  </ItemGroup>

</Project>
