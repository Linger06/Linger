<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0;net9.0;net8.0;</TargetFrameworks>
        <Version>2.0.0-preview.5</Version>
        <Description>
            ASP.NET Core integration for Linger.Email.
            Provides dependency injection, configuration binding, logging, and convenience email service wrappers.
        </Description>        
</PropertyGroup>

    <ItemGroup>
</ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" Condition="'$(TargetFramework)' == 'net8.0'" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.23" Condition="'$(TargetFramework)' == 'net9.0'" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" Condition="'$(TargetFramework)' == 'net10.0'" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" Condition="'$(TargetFramework)' == 'net11.0'" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" Condition="'$(TargetFramework)' == 'net8.0'" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.23" Condition="'$(TargetFramework)' == 'net9.0'" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" Condition="'$(TargetFramework)' == 'net10.0'" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0" Condition="'$(TargetFramework)' == 'net11.0'" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Linger.Configuration\Linger.Configuration.csproj" />
      <ProjectReference Include="..\Linger.Email\Linger.Email.csproj" />
    </ItemGroup>

</Project>
