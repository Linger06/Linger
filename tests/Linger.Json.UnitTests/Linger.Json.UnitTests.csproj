    </ItemGroup>

    <ItemGroup>
        <PackageReference Update="coverlet.collector" Version="10.0.1" />
        <PackageReference Update="Microsoft.NET.Test.Sdk" Version="18.8.1" />
        <PackageReference Update="xunit.v3" Version="3.2.2" />
    </ItemGroup>

</Project>
